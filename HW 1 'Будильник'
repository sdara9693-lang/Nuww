'''
# подключаем модуль datetime

# вводим время будильника одной строкой

# получаем текущее время
# сохраняем текущее время в виде строки часы и минуты

# если количество введённых значений не равно 2, то
#   выводим сообщение о некорректном вводе
# иначе
#   первое значение считаем часами, второе минутами

# проверяем, что часы и минуты состоят из цифр
# если проверка не пройдена, то
#   выводим сообщение о некорректном вводе
# иначе
#   сравниваем введённое время с текущим временем

# если введённые часы и минуты совпадают с текущими, то
#   выводим сообщение дзынь-дзынь
# иначе
#   переводим часы и минуты в целые числа

# проверяем корректность диапазона часов и минут

# если часы равны 0 и минуты равны 0, то
#   выводим полночь
# если часы равны 12 и минуты равны 0, то
#   выводим полдень
# иначе
#   определяем часть суток по значению часов

# определяем правильную форму слова час
# определяем правильную форму слова минута

# формируем текстовое описание времени

# если минуты равны 0 и часы не равны 0 и не равны 12, то
#   добавляем слово ровно

# выводим сообщение о том, что будильник установлен, и время будильника
'''

import datetime

def hours_answer(hours):
    answer = ''
    if hours == 1 or hours == 13:
        answer += str(hours % 12)
        answer += (' час')
    elif 2 <= hours <= 4 or 14 <= hours <= 16:
        answer += str(hours % 12)
        answer += (' часа')
    elif hours == 12:
        answer += str(hours)
        answer += (' часов')
    elif hours == 0 or 5 <= hours <= 11 or 17 <= hours <= 23:
        answer += str(hours % 12)
        answer += (' часов')
    return answer

def minutes_answer(minutes):
    answer = ''
    if minutes % 10 == 1 and minutes // 10 != 1:
        answer += ' '
        answer += str(minutes)
        answer += ' минута'
    elif (minutes % 10 == 2 or minutes % 10 == 3 or minutes % 10 == 4) and minutes != 13:
        answer += ' '
        answer += str(minutes)
        answer += ' минуты'
    elif 5 <= minutes <= 20 or 25 <= minutes <= 30 or 35 <= minutes <= 40 or 45 <= minutes <= 50 or 55 <= minutes <= 59:
        answer += ' '
        answer += str(minutes)
        answer += ' минут'
    return answer

def day_answer(hour, minutess):
    answer = ''
    if not 0 <= hour < 24:
        answer = 'Введены недопустимые данные: часы должны быть от 0 до 23.'
    elif not 0 <= minutess <= 59:
        answer = 'Введены недопустимые данные: минуты должны быть от 0 до 59.'
    elif hour == 0 and minutess == 0:
        answer = 'полночь'
    elif hour == 12 and minutess == 0:
        answer = 'полдень'
    elif 0 <= hour < 6:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' ночи'
    elif 6 <= hour < 12:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' утра'
    elif 12 <= hour < 18:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' дня'
    elif 18 <= hour < 24:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' вечера'
    if minutess == 0 and hour != 0 and hour != 12:
        answer += ' ровно'
    return answer

def check(input_user):
    input_user = str(input_user)
    for i in range (len(input_user) - 1):
        if input_user[i] in '0123456789' and input_user[i + 1] in '0123456789':
            return True
        else:
            return False

user_input = list(input('Введите время, на которое хотите поставить будильник: ').split())

now = datetime.datetime.now()
now_str = (now. strftime("%H %M"))

if len(user_input) != 2:
    print('ввод неккоретный')
else:
    hours_str = user_input[0]
    minutes_str = user_input[1]
    if check(hours_str) == False or check(minutes_str) == False:
        print('ввод неккоректен')

    elif now_str[0:2] == hours_str and now_str[3:5] == minutes_str:
        print('Дзынь-дзынь!')
    else:
        hours = int(hours_str)
        minutes = int(minutes_str)
        print('Будильник установлен на', day_answer(hours, minutes))
