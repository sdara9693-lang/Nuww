'''
# Алгоритм работы программы:
#
# Ввести часы и минуты.
# Создать пустой список answer.
#
# Проверить правильность данных:
# - Если часы не от 0 до 23, вывести ошибку.
# - Если минуты не от 0 до 59, вывести ошибку.
#
# Проверить особые случаи:
# - Если 0:00, вывести "полночь".
# - Если 12:00, вывести "полдень".
#
# Если особых случаев нет:
#
# Определить правильное написание часов:
# - Если час = 1 или 13:
#   - Добавить в список (час % 12).
#   - Добавить в список "час".
# - Если час от 2 до 4 или от 14 до 16:
#   - Добавить в список (час % 12).
#   - Добавить в список "часа".
# - Если час = 12:
#   - Добавить в список 12.
#   - Добавить в список "часов".
# - Если час = 0, или от 5 до 11, или от 17 до 23:
#   - Добавить в список (час % 12).
#   - Добавить в список "часов".

# Определить правильное написание минут:
# - Если минуты = 0:
#   - добавить "ровно".
# - Если 1, 21, 31, 41, 51:
    - добавить "минута".
# - Если 2-4, 22-24, 32-34, 42-44, 52-54:
    - добавить "минуты".
# - Остальные случаи:
    - добавить "минут".

# Определить часть суток:
# - Если час меньше 6 и не равен 0:
    - Добавить в список "ночи".
# - Если от 6 до 11:
    - Добавить в список "утра".
# - Если от 12 до 17:
    - Добавить в список "дня".
# - Если от 18 до 23:
    - Добавить в список "вечера".

# Вывести результат из списка answer.
'''

def hours(a):
    if a == 1 or a == 13:
        answer.append(a % 12)
        answer.append('час')
    elif 2 <= a <= 4 or 14 <= a <= 16:
        answer.append(a % 12)
        answer.append('часа')
    elif a == 12:
        answer.append(12)
        answer.append('часов')
    elif a == 0 or 5 <= a <= 11 or 17 <= a <= 23:
        answer.append(a % 12)
        answer.append('часов')

def minutes(a):
    if a == 0:
        answer.append('ровно')
    elif a == 1 or a == 21 or a == 31 or a == 41 or a == 51:
        answer.append(a)
        answer.append('минута')
    elif 2 <= a <= 4 or 22 <= a <= 24 or 32 <= a <= 34 or 42 <= a <= 44 or 52 <= a <=54:
        answer.append(a)
        answer.append('минуты')
    elif 5 <= a <= 20 or 25 <= a <= 30 or 35 <= a <= 40 or 45 <= a <= 50 or 55 <= a <= 59:
        answer.append(a)
        answer.append('минут')

def day(hour, answer):
    if hour < 6 and hour != 0:
        answer.append('ночи')
    if 5 < hour < 12:
        answer.append('утра')
    if 11 < hour < 18:
        answer.append('дня')
    if 17 < hour < 24:
        answer.append('вечера')


hour, minute = list(map(int,input('Введите время:  ').split()))
answer = []

if not 0 <= hour <= 23:
        print('Введены недопустимые данные: часы должны быть от 0 до 23.')
elif not 0 <= minute <=59:
    print('Введены недопустимые данные: минуты должны быть от 0 до 59.')
elif hour == 0 and minute == 0:
        print('полночь')
elif hour == 12 and minute == 0:
    print('полдень')
else:
    hours(hour)
    minutes(minute)
    day(hour, answer)

    print(*answer)
