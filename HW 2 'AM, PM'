    answer = ''
    if 0 < hours <= 12:
        answer += str(hours % 12)
    elif 13 <= hours <= 24 or hours == 0:
        answer += str(hours % 12)
    return answer

def minutes_answer(minutes):
    answer = ''
    if minutes % 10 == 1 and minutes // 10 != 1:
        answer += ' '
        answer += str(minutes)
        answer += ' минута'
    elif (minutes % 10 == 2 or minutes % 10 == 3 or minutes % 10 == 4) and minutes != 13:
        answer += ' '
        answer += str(minutes)
        answer += ' минуты'
    elif 5 <= minutes <= 20 or 25 <= minutes <= 30 or 35 <= minutes <= 40 or 45 <= minutes <= 50 or 55 <= minutes <= 59:
        answer += ' '
        answer += str(minutes)
        answer += ' минут'
    return answer

