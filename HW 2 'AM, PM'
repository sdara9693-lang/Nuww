def day_answer_two(hour, minutess):
    answer = ''
    if not 0 <= hour < 24:
        answer = 'Введены недопустимые данные: часы должны быть от 0 до 23.'
    elif not 0 <= minutess <= 59:
        answer = 'Введены недопустимые данные: минуты должны быть от 0 до 59.'
    elif 0 <= hour <= 11:
        answer += hours_answer_two(hour) + ':'+ minutes_answer_two(minutess) + ' AM'
    elif 12 <= hour <= 23:
        answer += hours_answer_two(hour) + ':' + minutes_answer_two(minutess) + ' PM'
    return answer

def day_answer(hour, minutess):
    answer = ''
    if not 0 <= hour < 24:
        answer = 'Введены недопустимые данные: часы должны быть от 0 до 23.'
    elif not 0 <= minutess <= 59:
        answer = 'Введены недопустимые данные: минуты должны быть от 0 до 59.'
    elif hour == 0 and minutess == 0:
        answer = 'полночь'
    elif hour == 12 and minutess == 0:
        answer = 'полдень'
    elif 0 <= hour < 6:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' ночи'
    elif 6 <= hour < 12:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' утра'
    elif 12 <= hour < 18:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' дня'
    elif 18 <= hour < 24:
        answer = hours_answer(hour) + minutes_answer(minutess) + ' вечера'
    if minutess == 0 and hour != 0 and hour != 12:
        answer += ' ровно'
    return answer

