# выводим результат
'''

def hours_answer(hours):
    answer = ''
    if hours == 1 or hours == 13:
        answer += str(hours % 12)
        answer += (' час')
    elif 2 <= hours <= 4 or 14 <= hours <= 16:
        answer += str(hours % 12)
        answer += (' часа')
    elif hours == 12:
        answer += str(hours)
        answer += (' часов')
    elif hours == 0 or 5 <= hours <= 11 or 17 <= hours <= 23:
        answer += str(hours % 12)
        answer += (' часов')
    return answer

